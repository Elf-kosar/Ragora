# .env Ornek Dosyasi
# Bu dosyayi .env olarak kopyalayin ve kendi ayarlarinizi girin.

# MongoDB Ayarlari
MONGODB_URI=mongodb://localhost:27018/

# Spot ekip projesi MongoDB ayarlari
# Varsayilan olarak ayni MongoDB servisindeki Ragora.spot_collection okunur.
SPOT_MONGODB_URI=mongodb://localhost:27018/
SPOT_MONGODB_DB_NAME=Ragora
SPOT_MONGODB_COLLECTION=spot_collection
SPOT_VISUAL_MONGODB_COLLECTION=spot_visual_collection

# Qdrant Ayarlari
QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333
SPOT_QDRANT_COLLECTION=spot_chunks
SPOT_VISUAL_QDRANT_COLLECTION=spot_visual_chunks
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DEVICE=cpu

# Ollama + Qwen Ayarlari
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
VISION_RETRIEVAL_MODE=hybrid
SIMILARITY_THRESHOLD=0.55
SOURCE_DISPLAY_THRESHOLD=0.62
RETRIEVAL_K=5
MAX_CONTEXT_CHARS=3500

# HuggingFace Token (opsiyonel, bazi modeller icin gerekli)
# HF_TOKEN=your_huggingface_token_here
